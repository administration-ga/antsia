{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "telephone": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "production",
      "env": {
        "NATIVE_RELEASE_BUILD": "true",
        "NATIVE_CALLS_ENABLED": "false",
        "EXPO_PUBLIC_CONVEX_URL": "https://diligent-avocet-585.convex.cloud",
        "EXPO_PUBLIC_CONVEX_SITE_URL": "https://diligent-avocet-585.convex.site",
        "EXPO_PUBLIC_SITE_URL": "https://antsia.vercel.app",
        "EXPO_PUBLIC_NATIVE_SCHEME": "antsia",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_DEMO_CONVEX_URL": "https://vivid-hedgehog-655.convex.cloud",
        "EXPO_PUBLIC_DEMO_CONVEX_SITE_URL": "https://vivid-hedgehog-655.convex.site",
        "EXPO_PUBLIC_DEMO_SITE_URL": "https://antsia.vercel.app"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "node": "22.22.3",
      "bun": "1.4.2"
    },
    "simulateur": {
      "extends": "telephone",
      "env": {
        "NATIVE_IOS_SIMULATOR_BUILD": "true",
        "GYM_XCARGS": "-jobs 2 ARCHS=arm64 ONLY_ACTIVE_ARCH=YES"
      },
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "telephone",
      "distribution": "store",
      "env": {
        "NATIVE_IOS_APP_STORE_BUILD": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleTeamId": "5Y39TTNCM7",
        "ascAppId": "6825216214"
      }
    }
  }
}

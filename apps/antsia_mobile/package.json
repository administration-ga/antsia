  "name": "antsia-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "index.ts",
  "description": "Application native ANTSIA iOS et Android, sans pont DOM.",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsgo --noEmit -p tsconfig.json",

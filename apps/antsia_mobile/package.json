    "convex": "catalog:",
    "expo": "catalog:",
    "expo-font": "catalog:",
    "expo-crypto": "catalog:",
    "expo-web-browser": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-video": "catalog:",
    "react": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "zod": "catalog:",
    "@livekit/react-native": "catalog:",
    "@livekit/react-native-webrtc": "catalog:",

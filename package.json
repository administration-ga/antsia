{
  "name": "antsia-platform",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "//workspaces-note": "Espaces de travail du moteur. Les applications EXTERNES de DIASPORALE (../DIASPORALE/apps/*, ../DIASPORALE/packages/*) ajoutées le 15/10/2026 à la demande du prompt DIASPORALE PD0 — une seule installation, dans ANTSIA. Les tâches transverses passent par scripts/workspace-run.mjs (dupliqué du socle, ADR-0165) et non par turbo : turbo 2.x refuse tout le graphe dès qu'un espace de travail sort de la racine du dépôt. Les versions vivent UNE fois dans le catalogue ci-dessous ; un paquet les référence par \"catalog:\" (une seule instance de React et de Convex dans le magasin isolé). La racine dépend de @diasporale/domain (règles métier de DIASPORALE, TS pur) pour la SEULE tranche convex/modules/diaspora : aucun autre code du moteur n'importe un paquet d'application (cliquet no-cross-product-imports).",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "../DIASPORALE/apps/*",
      "../DIASPORALE/packages/*"
    ],
    "catalog": {
      "@convex-dev/aggregate": "0.2.1",
      "@convex-dev/better-auth": "0.12.5",
      "@convex-dev/migrations": "0.3.7",
      "@convex-dev/rate-limiter": "0.3.2",
      "@convex-dev/react-query": "0.1.0",
      "@convex-dev/resend": "0.2.4",
      "@edge-runtime/vm": "5.0.0",
      "@fontsource-variable/familjen-grotesk": "5.3.0",
      "@fontsource-variable/inter": "5.3.0",
      "@fontsource/dm-mono": "5.3.0",
      "@hookform/resolvers": "5.4.0",
      "@idn-ga/better-auth": "0.2.1",
      "@livekit/components-react": "2.9.24",
      "@livekit/components-styles": "1.2.0",
      "@tailwindcss/postcss": "4.3.3",
      "@tanstack/react-query": "5.101.4",
      "@testing-library/dom": "10.4.1",
      "@testing-library/jest-dom": "6.10.0",
      "@testing-library/react": "16.3.2",
      "@testing-library/user-event": "14.6.8",
      "@types/bun": "1.4.2",
      "@types/node": "22.20.1",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "better-auth": "1.6.25",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "convex": "1.45.0",
      "convex-helpers": "0.1.120",
      "convex-test": "0.0.54",
      "eslint": "9.39.5",
      "eslint-config-next": "16.4.2",
      "i18next": "26.3.6",
      "i18next-browser-languagedetector": "8.2.1",
      "jsdom": "29.1.1",
      "jszip": "3.10.1",
      "livekit-client": "2.22.3",
      "livekit-server-sdk": "2.19.1",
      "lucide-react": "1.26.0",
      "motion": "12.43.0",
      "next": "16.4.2",
      "next-themes": "0.4.6",
      "radix-ui": "1.8.1",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "react-hook-form": "7.82.0",
      "react-i18next": "16.6.6",
      "react-qr-code": "2.2.0",
      "sonner": "2.0.7",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "tslib": "2.8.1",
      "typescript": "6.0.3",
      "vitest": "4.1.10",
      "zod": "3.25.76",
      "web-push": "3.6.7",
      "@types/web-push": "3.6.4",
      "expo": "57.0.17",
      "expo-font": "57.0.4",
      "react-native": "0.86.3",
      "expo-secure-store": "~57.0.2",
      "expo-video": "~57.0.3",
      "expo-crypto": "~57.0.2",
      "expo-system-ui": "~57.0.3",
      "react-native-safe-area-context": "~5.7.0",
      "@livekit/react-native": "3.1.0",
      "@livekit/react-native-webrtc": "150.1.0",
      "@livekit/react-native-expo-plugin": "1.1.0",
      "@config-plugins/react-native-webrtc": "15.0.2",
      "expo-modules-core": "~57.0.14",
      "expo-dev-client": "~57.0.16",
      "@expo/config-plugins": "~57.0.9",
      "expo-web-browser": "~57.0.2"
    }
  },
  "scripts": {
    "codegen": "node scripts/convex-dev.mjs codegen",
    "typecheck:convex": "tsgo --noEmit -p convex/tsconfig.json",
    "typecheck:tests": "tsgo --noEmit -p tsconfig.json",
    "test": "bun run test:convex && bun run test:ratchets && bun run test:scripts",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "test:ratchets": "vitest run --config tests/vitest.config.ts",
    "test:scripts": "bun test scripts",
    "test:domain": "bun run --cwd packages/social-domain test",
    "native:acceptance": "bun scripts/native-acceptance.mjs",
    "typecheck": "node scripts/workspace-run.mjs typecheck --concurrency=2",
    "lint": "node scripts/workspace-run.mjs lint --concurrency=2",
    "verify": "bun run codegen && bun run typecheck:convex && bun run typecheck:tests && bun run test && node scripts/workspace-run.mjs typecheck --concurrency=1 && node scripts/workspace-run.mjs test --concurrency=1 && node scripts/workspace-run.mjs lint --concurrency=1",
    "dev:convex": "node scripts/convex-dev.mjs",
    "dev:antsia": "node scripts/workspace-run.mjs dev --filter=antsia-ga",
    "dev:admin": "node scripts/workspace-run.mjs dev --filter=admin-antsia-ga",
    "dev:diasporale": "node scripts/workspace-run.mjs dev --filter=diasporale-com",
    "build:antsia": "node scripts/workspace-run.mjs build --filter=antsia-ga",
    "build:admin": "node scripts/workspace-run.mjs build --filter=admin-antsia-ga",
    "build:diasporale": "node scripts/workspace-run.mjs build --filter=diasporale-com",
    "deploy:check": "node scripts/deploy-app.mjs --check",
    "deploy:antsia": "node scripts/deploy-app.mjs antsia_ga",
    "deploy:admin": "node scripts/deploy-app.mjs admin_antsia_ga",
    "deploy:diasporale": "node scripts/deploy-app.mjs diasporale_com"
  },
  "dependencies": {
    "@antsia/social-contracts": "workspace:*",
    "@antsia/social-domain": "workspace:*",
    "@convex-dev/aggregate": "catalog:",
    "@convex-dev/better-auth": "catalog:",
    "@convex-dev/migrations": "catalog:",
    "@convex-dev/rate-limiter": "catalog:",
    "@convex-dev/resend": "catalog:",
    "@diasporale/domain": "workspace:*",
    "@idn-ga/better-auth": "catalog:",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "catalog:",
    "jszip": "catalog:",
    "livekit-server-sdk": "catalog:",
    "zod": "catalog:",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@edge-runtime/vm": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "convex-test": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/web-push": "catalog:"
  }
}

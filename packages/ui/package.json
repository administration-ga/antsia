{
  "name": "@antsia/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Jetons, charte de base (dupliquée de la charte Personnel du socle), thèmes d'application et primitives du moteur ANTSIA.",
  "exports": {
    ".": "./src/index.ts",
    "./overlay": "./src/overlay/index.ts",
    "./sheet": "./src/sheet/index.ts",
    "./espace-kit": "./src/espace-kit/index.ts",
    "./styles.css": "./src/styles.css",
    "./themes/*.css": "./src/themes/*.css",
    "./lib/*": "./src/lib/*.ts",
    "./themes/antsia-native": "./src/themes/antsia-native.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/dm-mono": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@antsia/eslint-config": "workspace:*",
    "@antsia/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

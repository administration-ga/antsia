# ANTSIA — variables d'environnement (NOMS seulement : ce dépôt est PUBLIC).
# Aucune valeur ici, jamais. Deux endroits distincts :
#
# 1) ANTSIA/.env.local — ÉCRIT PAR LE CLI CONVEX (`bun run dev:convex`), à ne pas
#    éditer à la main. Les applications le lisent en développement
#    (`@antsia/api/next-config`) : aucune copie par application.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
#
# 2) Environnement du DÉPLOIEMENT Convex — posé par le propriétaire
#    (`bunx convex env set NOM valeur`), jamais dans un fichier du dépôt.
#    Authentification (Better Auth du moteur, prompt PA4) :
#      BETTER_AUTH_SECRET        (≥ 32 caractères)
#      SITE_URL                  (origine principale, ex. celle d'antsia.ga)
#      TRUSTED_ORIGINS           (origines des applications, séparées par des virgules)
#    Identité numérique IDN (identite.ga, client OIDC par application) :
#      IDN_CLIENT_ID, IDN_CLIENT_SECRET, IDN_ISSUER ou IDN_DISCOVERY_URL
#    Courriel (codes à usage unique, digests) : RESEND_API_KEY, RESEND_FROM_ADDRESS
#    SMS (codes à usage unique) : SMS_PROVIDER=webhook, SMS_ENDPOINT (HTTPS), SMS_API_KEY
#    Langue des codes (facultative) : AUTH_DEFAULT_LOCALE (fr ou en)
#    Temps réel (appels, directs) : LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_WS_URL ;
#      réveil d'un serveur qui se suspend (facultatives) : LIVEKIT_WAKE_URL, LIVEKIT_WAKE_TOKEN ;
#      rediffusion des directs (Egress) : le webhook `/webhooks/livekit-egress` vérifie le
#      jeton de LiveKit avec LIVEKIT_API_KEY / LIVEKIT_API_SECRET ; facultatives :
#      LIVEKIT_EGRESS_URL (service d'enregistrement hébergé ailleurs que le serveur vidéo),
#      LIVEKIT_WEBHOOK_SECRET (secret fixe d'un relais du webhook — jamais requis)
#    Applications des notifications (PA5) : NOTIFICATION_APPLICATIONS_JSON
#      tableau JSON (32 entrées maximum) : applicationId, networkSlug, origin, entryPath ;
#      origine HTTPS exacte et chemin d'entrée relatif sur cette origine. Sans registre,
#      aucune application ni origine par défaut. HTTP loopback réservé au développement.
#    Push Web : VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT,
#      WEB_PUSH_ALLOWED_ORIGINS (origines des services push séparées par des virgules)
#    Expo : EXPO_PUSH_ENDPOINT, EXPO_RECEIPTS_ENDPOINT ; EXPO_ACCESS_TOKEN facultatif
#    FCM : FCM_SEND_ENDPOINT, FCM_OAUTH_ENDPOINT, FCM_OAUTH_SCOPE,
#      FCM_SERVICE_ACCOUNT_JSON (champs client_email et private_key)
#    APNs : APNS_ENDPOINT, APNS_PRIVATE_KEY, APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC
#      Les endpoints des fournisseurs sont explicitement configurés, HTTPS, sans
#      identifiants d'URL ni fragment ; aucune redirection n'est suivie.
#      Une admission du transport ne prouve pas la réception sur un appareil.
#    Fédération (inbox signée, PA5/PA9) : FEDERATION_ENVIRONMENT
#      environnement reconnu : sandbox ou production ; absence = indisponible.
#      Clés par émetteur/environnement : noms ANTSIA_FEDERATION_<IDENTIFIANT>_KEY,
#      sélectionnés dans le registre des émetteurs (majuscules ASCII, chiffres,
#      underscores ; 160 caractères maximum). Secret UTF-8 de 32 octets minimum.
#      Aucun secret dans la base ni dans ce fichier. Le registre métier est fermé
#      en PA5 : admission authentifiée en lettres mortes, sans appliquer de reflet.
#      PA9D : ANTSIA_ADMINISTRATION_PUBLIC_ORIGIN — origine exacte du portail
#      administratif pour continuer un accord d'agent. HTTPS ; loopback HTTP
#      réservé à sandbox. Aucun sujet IDN ni consentRef dans le lien navigateur.
#    Développement seulement : ANTSIA_DEV_TOOLS (jamais en production)
#
# Les variables des applications Next (NEXT_PUBLIC_*) sont listées dans
# apps/*/.env.example et inscrites au build par les ARG du Dockerfile
# (catalogue deploy/catalog.json).

# Démo sur le site principal : deux builds, backends distincts.
# Principal : affiche l'entrée /demo si true. Enfant : basePath /demo uniquement
# pour le backend cloud démo autorisé ; sinon aucun changement.
NEXT_PUBLIC_DEMO_ENTRY_ENABLED=
NEXT_PUBLIC_APP_BASE_PATH=
# Relais privé, variables serveur uniquement, jamais des ARG Docker publics.
ANTSIA_DEMO_RUNTIME_ORIGIN=
ANTSIA_DEMO_PROXY_TOKEN=
ANTSIA_DEMO_HOSTING_BYPASS=

# MP06 — options serveur non secrètes, fermées par défaut.
# Les activer ne remplace pas l'opt-in de source, le mandat et le consentement PRO.
ANTSIA_COMMERCE_SERVICE_CONTROL_V2=false
ANTSIA_COMMERCE_MERCHANT_READ_ENABLED=false
# MP07 — lecture de préparation financière seulement ; aucun moyen activé.
ANTSIA_COMMERCE_PAYMENT_PREPARATION_ENABLED=false
